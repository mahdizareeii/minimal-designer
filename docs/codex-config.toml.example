# Preferred setup: let FormaSpec start and authorize the loopback bridge,
# configure Codex, install the managed FormaSpec skill/plugin, and verify the
# connection automatically:
#
#   pnpm formaspecctl --yes agent connect codex
#
# Manual fallback. Point Codex at the token-free local bridge, not directly at
# the upstream API on port 4310, and do not add a bearer token to Codex config.
[mcp_servers.formaspec]
url = "http://127.0.0.1:4312/mcp"
required = true
default_tools_approval_mode = "writes"
tool_timeout_sec = 60

# After the managed plugin is installed, mention it in Codex with:
# [@FormaSpec](plugin://formaspec@formaspec)
