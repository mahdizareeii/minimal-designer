# Preferred setup: let FormaSpec start and authorize the loopback bridge,
# configure Codex, install the primary managed FormaSpec version-0.2.0
# skills/plugins plus the Minimal UI legacy compatibility assets, and verify
# the connection automatically:
#
#   pnpm formaspecctl --yes agent connect codex
#
# Manual fallback. Point Codex at the token-free local bridge, not directly at
# the upstream API on port 4310, and do not add a bearer token to Codex config.
[mcp_servers.formaspec]
url = "http://127.0.0.1:4312/mcp"
required = true
default_tools_approval_mode = "writes"
tool_timeout_sec = 60

# After the managed plugins are installed, start a new task and use:
# [@FormaSpec](plugin://formaspec@formaspec)
#
# Backward compatibility only; retain for existing prompts, not new examples:
# [@Minimal UI](plugin://minimal-ui@formaspec)
