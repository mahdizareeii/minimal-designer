{
  "name": "@designer/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:renderer": "node dist/renderer-worker.js",
    "start:restore-worker": "node dist/restore-worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run --maxWorkers=2",
    "test:e2e:alignment": "playwright test --config playwright.config.ts e2e/selection-alignment.spec.ts",
    "test:e2e:alignment:cross-browser": "playwright test --config playwright.cross-browser.config.ts e2e/selection-alignment.spec.ts",
    "test:e2e:editor": "playwright test --config playwright.config.ts e2e/editor-information-architecture.spec.ts e2e/organization-policy-administration.spec.ts --project=chromium-dpr-1",
    "test:e2e:handoff": "playwright test --config playwright.config.ts e2e/handoff-execution-decisions.spec.ts --project=chromium-dpr-1",
    "test:e2e:performance": "tsc -p performance/tsconfig.browser.json && playwright test --config playwright.performance.config.ts",
    "test:e2e:release": "tsc -p e2e/tsconfig.release.json && playwright test --config playwright.release.config.ts",
    "test:e2e:visual": "tsc -p e2e/tsconfig.json && playwright test --config playwright.visual.config.ts e2e/visual-regression.spec.ts",
    "test:e2e:visual:update": "tsc -p e2e/tsconfig.json && playwright test --config playwright.visual.config.ts e2e/visual-regression.spec.ts --update-snapshots",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@designer/core": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.2.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.4.0",
    "fflate": "0.8.3",
    "playwright": "1.61.1",
    "tar-stream": "^3.2.0",
    "zod": "^3.25.67",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/tar-stream": "^3.1.4"
  }
}
